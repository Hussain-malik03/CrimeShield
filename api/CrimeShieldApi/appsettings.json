{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<DB_HOST>;Port=5432;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true;Timeout=100;Pooling=true;Maximum Pool Size=100;CommandTimeout=300;"
  },
  "GraphHopper": {
    "ApiKey": "<GRAPHHOPPER_API_KEY>"
  }
}
